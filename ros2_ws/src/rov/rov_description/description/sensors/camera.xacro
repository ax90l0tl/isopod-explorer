<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="camera_base">
    </link>

    <joint name="camera_base_joint" type="fixed">
        <parent link="chassis" />
        <child link="camera_base" />
        <origin xyz="0.155 0 0" />
    </joint>

    <link name="camera">
        <inertial>
            <mass value="0.015" />
            <inertia
                ixx="0.001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.001"
                iyz="0"
                izz="0.001" />
        </inertial>
    </link>

    <joint name="camera_joint" type="revolute">
        <parent link="camera_base" />
        <child link="camera" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="-${pi/4}" upper="${pi/4}" effort="10.0" velocity="1.0" />

    </joint>

    <xacro:if value="$(arg simulation)">
        <gazebo>
            <plugin
                filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
                <joint_name>camera_joint</joint_name>
                <topic>joint/knee_joint/0/cmd_pos</topic>
                <p_gain>10.0</p_gain>
                <i_gain>0.0</i_gain>
                <d_gain>1.0</d_gain>
                <i_max>100</i_max>
                <i_min>-100</i_min>
                <cmd_max>100</cmd_max>
                <cmd_min>-100</cmd_min>
                <cmd_offset>0.0</cmd_offset>
            </plugin>
        </gazebo>

        <gazebo reference="camera">
            <sensor name="camera" type="camera">
                <camera>
                    <optical_frame_id>camera</optical_frame_id>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <format>R8G8B8</format>
                        <width>640</width>
                        <height>480</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>20.0</far>
                    </clip>
                </camera>
                <topic>/camera/image_raw</topic>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <enable_metrics>false</enable_metrics>
            </sensor>
        </gazebo>
    </xacro:if>
</robot>