[submodule "ros2_ws/src/micro_ros_setup"]
	path = ros2_ws/src/micro_ros_setup
	url = https://github.com/micro-ROS/micro_ros_setup.git
	branch = jazzy
[submodule "ros2_ws/src/ros_gz"]
	path = ros2_ws/src/ros_gz
	url = https://github.com/gazebosim/ros_gz.git
	branch = jazzy
[submodule "micro_ros_ws/pico_controller/micro_ros_raspberrypi_pico_sdk"]
