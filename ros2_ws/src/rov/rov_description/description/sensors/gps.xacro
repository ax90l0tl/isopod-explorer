<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:macro name="gps_sensor" params="name parent *origin">
        <link name="${name}">
        </link>
        <!-- Joint between thruster link and vehicle base link -->    
        <joint name="${name}_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${name}" />
        </joint>
        <xacro:if value="$(arg simulation)">
            <gazebo reference="${name}">
                <sensor name="${name}" type="navsat">
                    <always_on>1</always_on>
                    <update_rate>10</update_rate>
                    <topic>${name}</topic>
                    <gz_frame_id>${name}</gz_frame_id>
                    <gps>
                        <position_sensing>
                            <horizontal>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.1</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.0</bias_stddev>
                            </noise>
                            </horizontal>
                            <vertical>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.1</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.0</bias_stddev>
                            </noise>
                            </vertical>
                        </position_sensing>
                        <velocity_sensing>
                            <horizontal>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.2</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.0</bias_stddev>
                            </noise>
                            </horizontal>
                            <vertical>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.2</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.0</bias_stddev>
                            </noise>
                            </vertical>
                        </velocity_sensing>
                    </gps>
                </sensor>
            </gazebo>
        </xacro:if>
    </xacro:macro>

    <xacro:gps_sensor name="gps" parent="chassis">
        <origin xyz="0 0 0.010" rpy="0 0 0"/>
    </xacro:gps_sensor>

</robot>