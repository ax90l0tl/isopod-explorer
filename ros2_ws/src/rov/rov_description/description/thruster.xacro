<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="prop_mesh_cw" value="file://$(find rov_description)/meshes/T200_cw.dae"/>
    <xacro:property name="prop_mesh_ccw" value="file://$(find rov_description)/meshes/T200_ccw.dae"/>
    <xacro:property name="prop_r" value="0.038"/>
    <xacro:property name="prop_l" value="0.0508"/>
    
    <!--  Thruster macro: joint + link + plugin -->
    <xacro:macro name="thruster" params="thruster_id dir parent *origin">

        <link name="thruster${thruster_id}">

            <visual>
                <geometry>
                    <xacro:if value="${dir == 'CW'}">
                        <mesh filename="${prop_mesh_cw}"/>
                    </xacro:if>
                    <xacro:if value="${dir == 'CCW'}">
                        <mesh filename="${prop_mesh_ccw}"/>
                    </xacro:if>
                </geometry>
            </visual>
            
            <inertial>
                <!-- thruster axis is X -->
                <origin xyz="${prop_l/2} 0 0" rpy="0 0 0" />
                <mass value="${prop_mass}" />
                <inertia  izz="${prop_mass*prop_r*prop_r / 4  + prop_mass*prop_l*prop_l / 12}" ixy="0.0"  ixz="0.0"
                            iyy="${prop_mass*prop_r*prop_r / 4  + prop_mass*prop_l*prop_l / 12}" iyz="0.0"
                            ixx="${prop_mass*prop_r*prop_r / 2}" />
            </inertial>
        </link>

        <!-- Joint between thruster link and vehicle base link -->    
        <joint name="thruster${thruster_id}_joint" type="continuous">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="thruster${thruster_id}" />
            <xacro:if value="${dir == 'CW'}">
                <axis xyz="1 0 0" />
            </xacro:if>
            <xacro:if value="${dir == 'CCW'}">
                <axis xyz="-1 0 0" />
            </xacro:if>
            <limits effort="-1" velocity="-1"/>
        </joint>

    <xacro:if value="$(arg simulation)">
        <gazebo>
            <plugin
                filename="gz-sim-thruster-system"
                name="gz::sim::systems::Thruster">
                <joint_name>thruster${thruster_id}_joint</joint_name>
                <topic>thruster${thruster_id}/cmd</topic>
                <!-- <use_angvel_cmd>true</use_angvel_cmd> -->
                <!-- <velocity_control>false</velocity_control> -->
                <!-- <thrust_coefficient>80.2073</thrust_coefficient> -->
                <fluid_density>${density}</fluid_density>
                <propeller_diameter>${2*prop_r}</propeller_diameter>
                <!-- <max_thrust_cmd>1.2805</max_thrust_cmd> -->
                <!-- <min_thrust_cmd>-1.0</min_thrust_cmd> -->
                <max_thrust_cmd>51.48491</max_thrust_cmd>
                <min_thrust_cmd>-40.2073</min_thrust_cmd>
            </plugin>
        </gazebo>
    </xacro:if>
    </xacro:macro>

</robot>
